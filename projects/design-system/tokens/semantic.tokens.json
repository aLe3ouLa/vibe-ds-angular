{
  "color": {
    "action": {
      "primary": { "$type": "color", "$value": "{color.green.500}" },
      "primary-hover": { "$type": "color", "$value": "{color.green.600}" },
      "primary-text": { "$type": "color", "$value": "{color.black}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.white}" },
      "subtle": { "$type": "color", "$value": "{color.gray.50}" },
      "inverse": { "$type": "color", "$value": "{color.dark}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.200}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.gray.900}" },
      "muted": { "$type": "color", "$value": "{color.gray.700}" },
      "inverse": { "$type": "color", "$value": "{color.white}" }
    },
    "feedback": {
      "error": { "$type": "color", "$value": "{color.red.600}" },
      "success": { "$type": "color", "$value": "{color.green.700}" },
      "warning": { "$type": "color", "$value": "{color.yellow.500}" },
      "info": { "$type": "color", "$value": "{color.blue.500}" }
    }
  }
}
